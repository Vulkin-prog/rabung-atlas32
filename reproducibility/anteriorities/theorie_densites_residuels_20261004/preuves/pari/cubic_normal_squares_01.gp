default(parisizemax,1024000000);
default(parisize,128000000);
setrand(1);
run()={my(fp=(-566104520160)*y^0+(0)*y^1+(4435693201)*y^2+(0)*y^3+(-133202)*y^4+(0)*y^5+(1)*y^6,nf,roots=[Mod((4078473223/17076311)*y^0+(0)*y^1+(-333005/34152622)*y^2+(0)*y^3+(3/34152622)*y^4+(0)*y^5,fp),Mod((-357219978/17076311)*y^0+(1/2)*y^1+(333005/68305244)*y^2+(0)*y^3+(-3/68305244)*y^4+(0)*y^5,fp),Mod((-357219978/17076311)*y^0+(-1/2)*y^1+(333005/68305244)*y^2+(0)*y^3+(-3/68305244)*y^4+(0)*y^5,fp)],sets=[[12, 65, 118, 121, 124, 128, 129, 132, 133, 143, 152], [13, 66, 113, 114, 115, 121, 124, 125, 126, 129, 130, 134, 135, 137, 143, 149, 150, 152], [15, 24, 71, 77, 79, 81, 82, 90, 97, 114, 118, 121, 124, 126, 130, 134, 136, 149, 150], [17, 24, 44, 70, 77, 97, 115, 118, 124, 128, 129, 130, 134, 136, 149, 152], [18, 24, 44, 71, 77, 97, 114, 118, 121, 124, 128, 130, 133, 134, 135, 136], [19, 24, 44, 72, 77, 97, 113, 114, 118, 119, 121, 123, 126, 129, 133, 134, 136, 137, 143, 152], [20, 24, 44, 76, 77, 79, 82, 90, 96, 97, 99, 128, 130, 132, 135, 150], [22, 24, 76, 77, 90, 96, 99, 126, 130, 132, 135]],z,rt,t);
 nf=nfinit(fp);for(i=1,#sets,z=prod(j=1,#sets[i],roots[sets[i][j]\53+1]+sets[i][j]%53);
  if(!nfeltissquare(nf,z,&rt),error("unsatisfied relation"));t=lift(nfbasistoalg(nf,rt));
  if(Mod(t,fp)^2!=z,error("identity"));print("SQUARE ",vector(6,j,Str(polcoef(t,j-1)))));
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
