default(parisizemax,1024000000);
default(parisize,128000000);
setrand(1);
run()={my(fp=(-601585318656)*y^0+(0)*y^1+(-71799455268)*y^2+(0)*y^3+(3306171393)*y^4+(0)*y^5+(-50719084)*y^6+(0)*y^7+(342630)*y^8+(0)*y^9+(-984)*y^10+(0)*y^11+(1)*y^12,nf,roots=[Mod((-16097000871493/753091405349)*y^0+(1)*y^1+(1173465405390841/506077424394528)*y^2+(0)*y^3+(-425847367255351/6072929092734336)*y^4+(0)*y^5+(464352032273/674769899192704)*y^6+(0)*y^7+(-4795576895/2024309697578112)*y^8+(0)*y^9+(16183087/6072929092734336)*y^10+(0)*y^11,fp),Mod((-16097000871493/753091405349)*y^0+(-1)*y^1+(1173465405390841/506077424394528)*y^2+(0)*y^3+(-425847367255351/6072929092734336)*y^4+(0)*y^5+(464352032273/674769899192704)*y^6+(0)*y^7+(-4795576895/2024309697578112)*y^8+(0)*y^9+(16183087/6072929092734336)*y^10+(0)*y^11,fp)],sets=[[20, 21, 31, 33, 38, 41, 43, 45, 47, 72, 73, 83, 85, 90, 93, 95, 97, 99], [22, 37, 45, 74, 89, 97], [23, 29, 38, 43, 45, 47, 75, 81, 90, 95, 97, 99], [53, 73, 74], [55, 73, 74, 75, 81, 90, 99, 101], [57, 73, 74, 81, 89, 90, 91, 97, 99], [59, 73, 74, 75, 81, 83, 85, 89, 90, 99], [60, 73, 75, 81, 83, 89, 90]],z,rt,t);
 nf=nfinit(fp);for(i=1,#sets,z=prod(j=1,#sets[i],roots[sets[i][j]\52+1]+sets[i][j]%52);
  if(!nfeltissquare(nf,z,&rt),error("unsatisfied relation"));t=lift(nfbasistoalg(nf,rt));
  if(Mod(t,fp)^2!=z,error("identity"));print("SQUARE ",vector(12,j,Str(polcoef(t,j-1)))));
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
