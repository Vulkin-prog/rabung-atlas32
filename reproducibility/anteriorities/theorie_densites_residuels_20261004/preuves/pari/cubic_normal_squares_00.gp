default(parisizemax,1024000000);
default(parisize,128000000);
setrand(1);
run()={my(fp=(-566104520160)*y^0+(0)*y^1+(4435693201)*y^2+(0)*y^3+(-133202)*y^4+(0)*y^5+(1)*y^6,nf,roots=[Mod((4078473223/17076311)*y^0+(0)*y^1+(-333005/34152622)*y^2+(0)*y^3+(3/34152622)*y^4+(0)*y^5,fp),Mod((-357219978/17076311)*y^0+(1/2)*y^1+(333005/68305244)*y^2+(0)*y^3+(-3/68305244)*y^4+(0)*y^5,fp),Mod((-357219978/17076311)*y^0+(-1/2)*y^1+(333005/68305244)*y^2+(0)*y^3+(-3/68305244)*y^4+(0)*y^5,fp)],sets=[[0, 44, 46, 63, 64, 65, 70, 71, 79, 83, 95, 96, 97, 106, 115, 118, 121, 123, 126, 129, 133, 134, 135, 136], [2, 39, 65, 70, 76, 82, 90, 96, 99, 114, 115, 118, 132, 143, 149], [3, 44, 65, 71, 77, 79, 81, 82, 90, 96, 118, 121, 128, 129, 130, 133, 134, 135, 149, 152], [7, 66, 70, 72, 76, 77, 79, 84, 90, 99, 113, 115, 118, 121, 123, 132, 133, 134, 136, 143, 149, 150], [8, 44, 65, 71, 76, 79, 81, 82, 83, 90, 99, 115, 121, 123, 124, 126, 128, 129, 132, 133, 149, 150, 152], [9, 44, 65, 70, 71, 81, 83, 90, 114, 115, 118, 124, 126, 128, 129, 134, 136, 143, 152], [10, 63, 106, 115, 117, 121, 124, 126, 128, 132, 133, 134, 135, 143, 148, 150, 152], [11, 42, 44, 64, 95, 97, 106, 114, 116, 121, 123, 124, 126, 128, 129, 133, 134, 143]],z,rt,t);
 nf=nfinit(fp);for(i=1,#sets,z=prod(j=1,#sets[i],roots[sets[i][j]\53+1]+sets[i][j]%53);
  if(!nfeltissquare(nf,z,&rt),error("unsatisfied relation"));t=lift(nfbasistoalg(nf,rt));
  if(Mod(t,fp)^2!=z,error("identity"));print("SQUARE ",vector(6,j,Str(polcoef(t,j-1)))));
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
