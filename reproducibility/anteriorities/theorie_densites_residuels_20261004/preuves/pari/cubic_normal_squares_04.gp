default(parisizemax,1024000000);
default(parisize,128000000);
setrand(1);
run()={my(fp=(-566104520160)*y^0+(0)*y^1+(4435693201)*y^2+(0)*y^3+(-133202)*y^4+(0)*y^5+(1)*y^6,nf,roots=[Mod((4078473223/17076311)*y^0+(0)*y^1+(-333005/34152622)*y^2+(0)*y^3+(3/34152622)*y^4+(0)*y^5,fp),Mod((-357219978/17076311)*y^0+(1/2)*y^1+(333005/68305244)*y^2+(0)*y^3+(-3/68305244)*y^4+(0)*y^5,fp),Mod((-357219978/17076311)*y^0+(-1/2)*y^1+(333005/68305244)*y^2+(0)*y^3+(-3/68305244)*y^4+(0)*y^5,fp)],sets=[[68, 71, 79, 81, 82, 90, 97, 121, 124, 132, 134, 135, 143, 150], [73, 76, 79, 82, 90, 96, 99, 126, 129, 132, 135, 143, 149, 152], [75, 76, 90, 96, 99, 128, 129, 143, 149, 152], [80, 81, 82, 90, 96, 97, 133, 134, 135, 143, 149, 150], [108, 118, 121, 123, 124, 126, 134, 135, 143, 145, 150], [109, 118, 124, 128, 129, 130, 132, 133, 143, 149, 152]],z,rt,t);
 nf=nfinit(fp);for(i=1,#sets,z=prod(j=1,#sets[i],roots[sets[i][j]\53+1]+sets[i][j]%53);
  if(!nfeltissquare(nf,z,&rt),error("unsatisfied relation"));t=lift(nfbasistoalg(nf,rt));
  if(Mod(t,fp)^2!=z,error("identity"));print("SQUARE ",vector(6,j,Str(polcoef(t,j-1)))));
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
