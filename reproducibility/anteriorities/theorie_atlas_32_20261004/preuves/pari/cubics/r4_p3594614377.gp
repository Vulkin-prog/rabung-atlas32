default(parisize,128000000);
default(parisizemax,512000000);
default(realprecision,64);
setrand(1);
image(M,r,w)={my(h=matsize(M)[1],lat);lat=concat(concat(M,r*matid(h)),w*matid(h)[,h]);r^(h-1)*gcd(r,w)/abs(matdet(mathnf(lat)));};
run()={my(r=4,m=30,v,fp,al,bn,U,S,E,ep,es,h,qs=[2, 3, 11, 17, 29, 61, 73, 101, 109, 127, 199, 257],small=[2, 3, 17]);
 v=polcompositum(x^3+(43)*x^2+(586)*x+(2592),polcyclo(r),1)[1];fp=v[1];al=v[2];
 if(!polisirreducible(x^3+(43)*x^2+(586)*x+(2592)),error("cubic reducible"));
 bn=bnfinit(fp,1);if(bnfcertify(bn)!=1,error("uncertified"));
 S=concat(vector(#qs,j,idealprimedec(bn,qs[j])));U=bnfunits(bn,S);
 E=Mat(vector(m,j,bnfisunit(bn,al+j-1,U)));h=matsize(E)[1];
 if(h!=#U[1],error("S-unit failure"));
 ep=Mat(vector(#small,j,bnfisunit(bn,small[j],U)));es=bnfisunit(bn,-1,U);
 print("RESULT ",[r,m,poldegree(fp),bn.no,bn.tu[1],#S,h,image(E,r,bn.tu[1]),image(concat(concat(E,ep),Mat(es)),r,bn.tu[1])]);
 print("MATRIX ",vector(h,i,vector(m,j,E[i,j])));
 print("SMALL_MATRIX ",vector(h,i,vector(#small,j,ep[i,j])));
 print("SIGN_VECTOR ",Vec(es));
 print("CUBIC_FIELD_DISCRIMINANT ",nfdisc(x^3+(43)*x^2+(586)*x+(2592)));
 print("FIELD_POLYNOMIAL ",fp);print("ALPHA_EMBEDDING ",al);
 print("COMPACT_UNITS ",U[1]);
};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
