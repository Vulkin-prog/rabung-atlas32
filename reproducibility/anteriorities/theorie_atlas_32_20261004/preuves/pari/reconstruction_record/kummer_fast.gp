default(parisize,128000000);
default(parisizemax,512000000);
default(realprecision,64);
setrand(1);
gettime();
r=9; A=31; B=216; m=26;
v=polcompositum(x^2+A*x+B,polcyclo(r),1)[1];
bn=bnfinit(v[1],1);
print("STAGE_BNF ",gettime());
cert=bnfcertify(bn);
if(cert!=1,error("bnf not certified"));
print("STAGE_CERTIFIED ",gettime());
al=v[2];
qs=[2,3,11,31,43,79];
S=concat(vector(#qs,j,idealprimedec(bn,qs[j])));
U=bnfunits(bn,S);
print("STAGE_SUNITS ",gettime());
els=vector(m,j,al+j-1);
es=vector(m,j,bnfisunit(bn,els[j],U));
if(vector(m,j,#es[j])!=vector(m,j,#U[1]),error("failed S-unit decomposition"));
E=Mat(es);
ebar=vector(m,j,bnfisunit(bn,-A-al+j-1,U));
if(vector(m,j,#ebar[j])!=vector(m,j,#U[1]),error("failed conjugate decomposition"));
Eb=Mat(ebar);

h=matsize(E)[1];
sz=r^h/abs(matdet(mathnf(concat(E,r*matid(h)))));
szboth=r^h/abs(matdet(mathnf(concat(concat(E,Eb),r*matid(h)))));
print("RESULT ",[r,A,B,m,poldegree(v[1]),bn.no,bn.tu[1],#S,h,sz,szboth]);
print("MATRIX ",vector(h,i,vector(m,j,E[i,j])));
print("MATRIX_CONJ ",vector(h,i,vector(m,j,Eb[i,j])));
print("STAGE_DONE ",gettime());
quit;
