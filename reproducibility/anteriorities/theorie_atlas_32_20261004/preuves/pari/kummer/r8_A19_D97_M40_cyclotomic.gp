default(parisize,128000000);
default(parisizemax,512000000);
default(realprecision,64);
setrand(1);
image(M,r,w)={my(h=matsize(M)[1],lat);lat=concat(concat(M,r*matid(h)),w*matid(h)[,h]);r^(h-1)*gcd(r,w)/abs(matdet(mathnf(lat)));};
run()={
 my(r=8,A=19,B=66,m=40,v,fp,al,bn,cert,S,U,E,Eb,h,es,ebar,ep,et,qs=[2, 3, 11, 31, 43, 47, 53, 61, 73, 79, 89, 113, 197, 241, 313],small=[2, 3, 11]);
 gettime(); v=polcompositum(x^2+(19)*x+(66),polcyclo(r),1)[1]; fp=v[1]; al=v[2];
 bn=bnfinit(fp,1); print("STAGE_BNF ",gettime());
 cert=bnfcertify(bn); if(cert!=1,error("bnf not certified"));
 print("STAGE_CERTIFIED ",gettime());
 S=concat(vector(#qs,j,idealprimedec(bn,qs[j])));
 U=bnfunits(bn,S);
 es=vector(m,j,bnfisunit(bn,al+j-1,U));
 ebar=vector(m,j,bnfisunit(bn,-A-al+j-1,U));
 if(vector(m,j,#es[j])!=vector(m,j,#U[1]),error("failed S-unit decomposition"));
 if(vector(m,j,#ebar[j])!=vector(m,j,#U[1]),error("failed conjugate decomposition"));
 E=Mat(es); Eb=Mat(ebar); h=matsize(E)[1];
 et=bnfisunit(bn,-1,U);
 ep=Mat(vector(#small,j,bnfisunit(bn,small[j],U)));
 print("RESULT ",[r,A,B,m,poldegree(fp),bn.no,bn.tu[1],#S,h,image(E,r,bn.tu[1]),image(Eb,r,bn.tu[1]),image(concat(E,Eb),r,bn.tu[1]),image(concat(E,Mat(et)),r,bn.tu[1]),image(concat(concat(E,ep),Mat(et)),r,bn.tu[1])]);
 print("MATRIX ",vector(h,i,vector(m,j,E[i,j])));
 print("MATRIX_CONJ ",vector(h,i,vector(m,j,Eb[i,j])));
 print("SMALL_MATRIX ",vector(h,i,vector(#small,j,ep[i,j])));
 print("SIGN_VECTOR ",Vec(et));
 print("FIELD_POLYNOMIAL ",fp);
 print("ALPHA_EMBEDDING ",al);
 print("CLASSGROUP ",bn.cyc);
 print("COMPACT_UNITS ",U[1]);
 print("STAGE_DONE ",gettime());
};
iferr(run(),err,print("ERROR ",err);quit(1));
quit;
