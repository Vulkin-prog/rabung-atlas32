run()={my(fp=(651240)*y^0+(-399120)*y^1+(463486)*y^2+(-128230)*y^3+(62861)*y^4+(1502)*y^5+(-496)*y^6+(-4)*y^7+(1)*y^8,nf,roots=[Mod((-79069/12826)*y^0+(-149213/76956)*y^1+(2220161/1154340)*y^2+(8007/256520)*y^3+(-3259/209880)*y^4+(-73/769560)*y^5+(73/2308680)*y^6+(0)*y^7,fp),Mod((-433971/12826)*y^0+(149213/76956)*y^1+(-2220161/1154340)*y^2+(-8007/256520)*y^3+(3259/209880)*y^4+(73/769560)*y^5+(-73/2308680)*y^6+(0)*y^7,fp),Mod((-916812/32065)*y^0+(17264999/865755)*y^1+(-214312663/25972650)*y^2+(141046439/25972650)*y^3+(54784/519453)*y^4+(-1088071/25972650)*y^5+(-7609/25972650)*y^6+(1087/12986325)*y^7,fp),Mod((-365788/32065)*y^0+(-17264999/865755)*y^1+(214312663/25972650)*y^2+(-141046439/25972650)*y^3+(-54784/519453)*y^4+(1088071/25972650)*y^5+(7609/25972650)*y^6+(-1087/12986325)*y^7,fp)],sets=[[138, 162, 169, 174, 178, 179, 180, 181, 183, 184, 192, 196], [139, 178, 180, 184, 186, 188, 199], [140, 178, 181, 184, 188, 196, 199], [141, 159, 169, 174, 178, 179, 180, 181, 183, 184, 192, 196], [142, 158, 169, 174, 178, 179, 180, 181, 183, 184, 192, 196], [143, 157, 169, 174, 178, 179, 180, 181, 183, 184, 192, 196], [144, 169, 174, 178, 179, 180, 181, 184, 188, 191, 192, 196], [147, 174, 179, 180, 188], [156, 183, 188, 191], [160, 169, 174, 179, 180, 183, 188, 192, 199], [161, 169, 174, 179, 181, 183, 186, 188, 192, 196, 199], [164, 174, 179, 181, 183, 186, 188, 192, 199], [166, 179, 184, 191], [168, 169, 174, 179, 180, 181, 183, 186, 191, 192, 196, 199], [171, 174, 178, 180, 181, 184, 188], [172, 174, 178, 179, 180, 181, 183, 191, 192]],z,rt,t);
 nf=nfinit(fp);for(i=1,#sets,z=prod(j=1,#sets[i],roots[sets[i][j]\52+1]+sets[i][j]%52);
