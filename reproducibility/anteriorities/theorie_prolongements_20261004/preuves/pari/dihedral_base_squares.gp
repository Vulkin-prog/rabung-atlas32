default(parisizemax,512000000);
default(parisize,128000000);
setrand(1);
run()={my(P=x^4+80*x^3+2281*x^2+27240*x+116640,nf=nfinit(P),roots=[Mod(x,P),-40-Mod(x,P)],sets=[[0, 65, 70, 74, 75, 76, 77, 79, 80, 88], [1, 65, 70, 74, 75, 76, 77, 79, 80, 88, 91, 92], [2, 65, 70, 74, 75, 76, 77, 79, 80, 88, 90, 92], [3, 65, 70, 74, 75, 76, 77, 79, 80, 88, 89, 92], [4, 65, 70, 74, 75, 76, 77, 79, 80, 92], [5, 65, 70, 74, 75, 76, 77, 79, 80, 87, 88, 92], [6, 65, 70, 74, 75, 76, 77, 79, 80, 86, 88, 92], [7, 65, 70, 74, 75, 76, 77, 79, 80, 85, 88, 92], [8, 65, 70, 74, 75, 76, 77, 79, 80, 84, 88, 92], [9, 65, 70, 74, 75, 76, 77, 79, 80, 83, 88, 92], [10, 65, 70, 74, 75, 76, 77, 79, 80, 82, 88, 92], [11, 65, 70, 74, 75, 76, 77, 79, 80, 81, 88, 92], [12, 65, 70, 74, 75, 76, 77, 79, 88, 92], [13, 65, 70, 74, 75, 76, 77, 80, 88, 92], [14, 65, 70, 74, 75, 76, 77, 78, 79, 80, 88, 92], [15, 65, 70, 74, 75, 76, 79, 80, 88, 92], [16, 65, 70, 74, 75, 77, 79, 80, 88, 92], [17, 65, 70, 74, 76, 77, 79, 80, 88, 92], [18, 65, 70, 75, 76, 77, 79, 80, 88, 92], [19, 65, 70, 73, 74, 75, 76, 77, 79, 80, 88, 92], [20, 65, 70, 72, 74, 75, 76, 77, 79, 80, 88, 92], [21, 65, 70, 71, 74, 75, 76, 77, 79, 80, 88, 92], [22, 65, 74, 75, 76, 77, 79, 80, 88, 92], [23, 65, 70, 74, 75, 77, 79, 80, 82, 84, 87, 88, 92], [24, 65, 80, 87, 92], [25, 65, 75, 79, 84, 88, 92], [26, 65, 66, 70, 74, 75, 76, 77, 79, 80, 88, 92], [27, 70, 74, 75, 76, 77, 79, 80, 88, 92], [28, 74, 80, 82, 87, 95], [29, 63, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [30, 65, 70, 74, 76, 77, 79, 87, 88, 92], [31, 61, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [32, 65, 74, 76, 80, 82, 84, 92, 95], [33, 59, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [34, 58, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [35, 74, 76, 80, 82, 84, 95], [36, 74, 77, 80, 84, 92, 95], [37, 55, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [38, 54, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [39, 53, 65, 70, 74, 75, 76, 77, 79, 80, 88, 92], [40, 65, 70, 74, 75, 76, 77, 80, 84, 87, 88, 92], [43, 70, 75, 76, 84], [52, 79, 84, 87], [56, 65, 70, 75, 76, 79, 84, 88, 95], [57, 65, 70, 75, 77, 79, 82, 84, 88, 92, 95], [60, 70, 75, 77, 79, 82, 84, 88, 95], [62, 75, 80, 87], [64, 65, 70, 75, 76, 77, 79, 82, 87, 88, 92, 95], [67, 70, 74, 76, 77, 80, 84], [68, 70, 74, 75, 76, 77, 79, 87, 88], [69, 76, 82, 84, 87]],z,rt,t);
 for(i=1,#sets,z=prod(j=1,#sets[i],roots[sets[i][j]\52+1]+sets[i][j]%52);
  if(!nfeltissquare(nf,z,&rt),error("not a square"));t=lift(nfbasistoalg(nf,rt));
  if(Mod(t,P)^2!=z,error("identity"));print("SQUARE ",vector(4,j,Str(polcoef(t,j-1)))));
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
