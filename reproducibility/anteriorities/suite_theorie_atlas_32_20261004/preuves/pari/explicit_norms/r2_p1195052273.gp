default(parisize,128000000);default(parisizemax,512000000);default(realprecision,64);setrand(1);
run()={my(P=(1)*x^3+(37)*x^2+(390)*x^1+(1143)*x^0,r=2,m=55,v,fp,al,bn,U,S,E,K,T,h,qs=[3, 7, 11, 13, 19, 31, 37, 41, 43, 53, 59, 67, 89, 103, 113, 127, 131, 157, 181, 191, 223, 227, 233, 251, 263, 293, 421, 503, 907, 919, 1091, 1103, 1289, 1901, 2969, 3623, 5861, 6217, 15121, 29569, 50857],norms=[-1143, -789, -503, -279, -111, 7, 81, 117, 121, 99, 57, 1, -63, -129, -191, -243, -279, -293, -279, -231, -143, -9, 177, 421, 729, 1107, 1561, 2097, 2721, 3439, 4257, 5181, 6217, 7371, 8649, 10057, 11601, 13287, 15121, 17109, 19257, 21571, 24057, 26721, 29569, 32607, 35841, 39277, 42921, 46779, 50857, 55161, 59697, 64471, 69489],d=12001,units,xx);
 gettime();fp=P;al=Mod(x,fp);
 bn=bnfinit(fp,1);if(bnfcertify(bn)!=1,error("uncertified base"));
 S=concat(vector(#qs,j,idealprimedec(bn,qs[j])));U=bnfunits(bn,S);
 E=Mat(vector(m,j,bnfisunit(bn,al+j-1,U)));K=Mat(vector(m,j,bnfisunit(bn,norms[j],U)));T=Mat(bnfisunit(bn,d,U));h=#U[1];
 if(matsize(E)[1]!=h||matsize(K)[1]!=h||matsize(T)[1]!=h,error("S-unit failure"));
units=vector(h,i,nffactorback(bn,U[1][i]));
 for(j=1,m,if(nffactorback(bn,units,E[,j])!=nfalgtobasis(bn,al+j-1),error("root explicit equality"));if(nffactorback(bn,units,K[,j])!=nfalgtobasis(bn,norms[j]),error("norm explicit equality")));
 if(nffactorback(bn,units,T[,1])!=nfalgtobasis(bn,d),error("kernel explicit equality"));
 if(nfeltpow(bn,units[h],bn.tu[1])!=nfalgtobasis(bn,1),error("torsion equality"));
 print("FIELD_COEFFICIENTS ",vector(poldegree(fp)+1,i,Str(polcoef(fp,i-1))));
 print("ALPHA_COEFFICIENTS ",vector(poldegree(fp),i,Str(polcoef(lift(al),i-1))));
 print("UNITS ",vector(h,i,xx=lift(nfbasistoalg(bn,units[i]));vector(poldegree(fp),j,Str(polcoef(xx,j-1)))));
 print("EXPLICIT_DECOMPOSITIONS 1");
 print("RESULT ",[r,m,poldegree(fp),bn.no,bn.tu[1],#S,h]);
 print("MATRIX ",vector(h,i,vector(m,j,E[i,j])));print("NORM_MATRIX ",vector(h,i,vector(m,j,K[i,j])));print("KERNEL_MATRIX ",vector(h,i,[T[i,1]]));
 print("FIELD_POLYNOMIAL ",fp);print("ALPHA ",al);print("COMPACT_UNITS ",U[1]);print("CERTIFIED 1");print("MILLISECONDS ",gettime());
};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
