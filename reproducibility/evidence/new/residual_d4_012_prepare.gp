default(parisizemax,512000000);
default(parisize,128000000);
setrand(1);
run()={my(P=(1)*x^4+(48)*x^3+(713)*x^2+(3750)*x^1+(10433)*x^0,Q,C,raw,red,fp,alpha,nf,rt,q=1000000,rr,z,iota,v,logs,k=0);
 Q=subst(P,x,x/1)*1^(poldegree(P)-1);C=polcompositum(Q,x^2+1,1);
 raw=C[1];for(i=2,#C,if(poldegree(C[i][1])>poldegree(raw[1]),raw=C[i]));
 red=polredbest(raw[1],1);fp=subst(red[1],x,y);
 alpha=subst(subst(lift(raw[2]),x,red[2]),x,y)/1;nf=nfinit(fp);
 if(subst(P,x,alpha)!=0,error("root mapping"));
 print("FIELD ",vector(poldegree(fp)+1,i,Str(polcoef(fp,i-1))));
 print("ALPHA ",vector(poldegree(fp),i,Str(polcoef(lift(alpha),i-1))));
 print("GALOIS ",if(poldegree(Q)>2,polgalois(Q),[2,-1,1,"C2"]));
 print("DISCRIMINANT ",poldisc(P));
 while(k<192,q=nextprime(q+1);if(q%4!=1||(1>1&&q%1==0),next);rr=Vec(lift(polrootsmod(P,q)));if(!#rr,next);z=rr[1];
  if(prod(j=0,28-1,Mod(z+j,q))==0,next);iota=lift(znprimroot(q)^((q-1)/4));
  logs=vector(28,j,my(v=lift(Mod(z+j-1,q)^((q-1)/4)));if(v==1,0,if(v==iota,1,if(v==q-1,2,3))));
  print("SAMPLE ",[q,z,iota,logs]);k++);
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
