default(parisizemax,512000000);
default(parisize,128000000);
run()={my(p=2940141229,w=390499731,configs=[[2, 0, 1], [2, 0, 4], [2, 0, 14], [2, 0, 28], [2, 14, 1], [2, 14, 4], [2, 14, 14], [2, 14, 28], [3, 0, 1], [3, 0, 4], [3, 0, 14], [3, 0, 28], [3, 14, 1], [3, 14, 4], [3, 14, 14], [3, 14, 28], [4, 0, 1], [4, 0, 4], [4, 0, 14], [4, 0, 28], [4, 14, 1], [4, 14, 4], [4, 14, 14], [4, 14, 28], [5, 0, 1], [5, 0, 4], [5, 0, 14], [5, 0, 28], [5, 14, 1], [5, 14, 4], [5, 14, 14], [5, 14, 28], [6, 0, 1], [6, 0, 4], [6, 0, 14], [6, 0, 28], [6, 14, 1], [6, 14, 4], [6, 14, 14], [6, 14, 28]],d,t,B,L,U,C);
 for(k=1,#configs,d=configs[k][1];t=configs[k][2];B=configs[k][3];
 L=matrix(d+1,d+1,i,j,if(j==1,if(i==1,p,-lift(Mod(w+t,p)^(j-1))),0));
 L=matrix(d+1,d+1,i,j,if(i==1,if(j==1,p,-lift(Mod(w+t,p)^(j-1))),if(i==j,B^(i-1),0)));
 U=qflll(L);C=L*U;
 print("BASIS ",[configs[k],vector(d+1,j,vector(d+1,i,C[i,j]/B^(i-1)))]) );
 print("END 1");};
iferr(run(),err,print("ERROR ",err);quit(1));quit;
